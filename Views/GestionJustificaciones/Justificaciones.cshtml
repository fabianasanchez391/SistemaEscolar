@{
    ViewData["Title"] = "Justificaciones";
    ViewData["Page"] = "justificaciones";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/justificaciones.css" asp-append-version="true" />
}

<!-- ---- Hero ---- -->
<div class="module-hero">
    <div class="module-hero__left">
        <div class="module-hero__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
        </div>
        <div class="module-hero__text">
            <h1>Gestión de Justificaciones</h1>
            <p>Registre la justificación de una ausencia, adjunte el comprobante (PDF o imagen) y consulte todas las justificaciones enviadas.</p>
        </div>
    </div>
    <div class="module-hero__illustration" aria-hidden="true">
        <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
            <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
            <rect x="62" y="30" width="96" height="112" rx="8" fill="#1a2c56" />
            <rect x="74" y="48" width="72" height="6" rx="3" fill="#eaf1ff" />
            <rect x="74" y="62" width="72" height="6" rx="3" fill="#eaf1ff" />
            <rect x="74" y="76" width="46" height="6" rx="3" fill="#eaf1ff" />
            <circle cx="136" cy="116" r="14" fill="#22b573" />
            <path d="m129 116 5 5 9-10" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>
</div>

<div class="just-layout">

    <!-- =================== LISTADO =================== -->
    <section class="table-card just-list-card">
        <div class="just-card-head just-card-head--row">
            <div>
                <h2>Justificaciones enviadas</h2>
                <p id="justResultsTag">0 justificaciones</p>
            </div>
            <button class="btn btn--primary" id="btnNuevaJustificacion" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Nueva justificación
            </button>
        </div>

        <div class="table-toolbar">
            <label class="filter-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <input type="search" id="justSearchInput" placeholder="Buscar por nombre o cédula..." />
            </label>
            <div class="chip-group" id="estadoChips">
                <button class="chip is-active" data-estado="todas" type="button">Todas <span id="chipTodas">0</span></button>
                <button class="chip" data-estado="pendiente" type="button">Pendientes <span id="chipPendiente">0</span></button>
                <button class="chip" data-estado="aprobada" type="button">Aprobadas <span id="chipAprobada">0</span></button>
                <button class="chip" data-estado="rechazada" type="button">Rechazadas <span id="chipRechazada">0</span></button>
            </div>
        </div>

        <div class="table-scroll">
            <table class="attendance-table just-table">
                <thead>
                    <tr>
                        <th>Estudiante</th>
                        <th>Cédula</th>
                        <th>Día que faltó</th>
                        <th>Justificación</th>
                        <th>Adjunto</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="justTableBody"></tbody>
            </table>
        </div>

        <div class="empty-state" id="justEmptyState">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <div>No hay justificaciones que coincidan con los filtros.</div>
        </div>

        <!-- Pie de tabla: conteo y paginación (fuera de la tabla para que se acomode en responsive) -->
        <div class="table-footer">
            <span class="pg-info" id="justCountInfo">Mostrando 0 de 0 justificaciones</span>
            <div class="pagination-btns" id="justPagination"></div>
        </div>
    </section>
</div>

<!-- =================== MODAL: NUEVA JUSTIFICACIÓN =================== -->
<div class="modal-overlay" id="formModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-asistencia">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
                </div>
                <div>
                    <h2>Nueva justificación</h2>
                    <p>Los campos marcados con * son obligatorios</p>
                </div>
            </div>
            <button class="modal-close" id="formModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <form id="justForm" class="just-form just-form--modal" novalidate>
                <div class="field">
                    <label for="justCedula">Cédula del estudiante *</label>
                    <input type="text" id="justCedula" class="field-input" placeholder="Ej: 1-0543-5678" maxlength="20" autocomplete="off" />
                    <small class="field-hint" id="justCedulaHint"></small>
                </div>

                <div class="field">
                    <label for="justNombre">Nombre del estudiante *</label>
                    <input type="text" id="justNombre" class="field-input" placeholder="Nombre completo" maxlength="80" autocomplete="off" />
                </div>

                <div class="field">
                    <label for="justFecha">Día que faltó *</label>
                    <input type="date" id="justFecha" class="field-input" />
                </div>

                <div class="field">
                    <label for="justTexto">Justificación *</label>
                    <textarea id="justTexto" class="field-input field-textarea" rows="4" maxlength="500" placeholder="Explique el motivo de la ausencia..."></textarea>
                    <small class="field-hint field-hint--right"><span id="justContador">0</span>/500</small>
                </div>

                <div class="field">
                    <label>Comprobante (PDF o imagen)</label>
                    <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Subir comprobante">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></svg>
                        <div class="dropzone__title">Arrastre el archivo aquí o <span>búsquelo</span></div>
                        <div class="dropzone__sub">PDF, JPG, PNG o WEBP · máximo 5 MB</div>
                    </div>
                    <input type="file" id="justArchivo" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" hidden />

                    <!-- Aquí el JS inserta la vista previa del archivo (plantilla tplFilePreview) -->
                    <div id="filePreview" class="is-hidden"></div>
                </div>

                <div class="form-error is-hidden" id="justError" role="alert"></div>
            </form>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="btnCancelar" type="button">Cancelar</button>
            <button class="btn btn--success" id="btnEnviar" type="submit" form="justForm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
                Enviar justificación
            </button>
        </div>
    </div>
</div>

<!-- =================== MODAL: DETALLE =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-asistencia">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Justificación</h2>
                    <p id="detailModalSubtitle">Estudiante</p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body" id="detailBody"></div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
        </div>
    </div>
</div>

<!-- =================== TOAST DE CONFIRMACIÓN =================== -->
<div class="toast-success-overlay" id="successToast">
    <div class="toast-success-card">
        <div class="toast-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <div class="toast-success-text" id="successToastText">La justificación se envió correctamente</div>
    </div>
</div>

<!-- =========================================================
     PLANTILLAS HTML
     El JS solo las clona y rellena con textos; no construye HTML.
     ========================================================= -->
<!-- Fila de la tabla de justificaciones -->
<template id="tplJustRow">
    <tr>
        <td>
            <div class="user-cell">
                <div class="user-avatar" data-ref="avatar"></div>
                <span class="user-cell__name" data-ref="nombre"></span>
            </div>
        </td>
        <td data-ref="cedula"></td>
        <td class="just-fecha-cell" data-ref="fecha"></td>
        <td><div class="just-texto-cell" data-ref="texto"></div></td>
        <td class="cell-center">
            <span class="adjunto-tag" data-ref="adjuntoSi">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 12-8.6 8.6a5 5 0 0 1-7-7l9-9a3.3 3.3 0 0 1 4.7 4.7l-9 9a1.7 1.7 0 0 1-2.4-2.4l8.3-8.3" /></svg>
                <span data-ref="adjuntoTipo"></span>
            </span>
            <span class="adjunto-tag adjunto-tag--none" data-ref="adjuntoNo">Sin adjunto</span>
        </td>
        <td class="cell-center"><span class="hist-badge" data-ref="estado"></span></td>
        <td>
            <div class="row-actions">
                <button class="row-action-btn view-btn" data-ref="ver" title="Ver detalle" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
                <button class="row-action-btn approve-btn" data-ref="aprobar" title="Aprobar" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                </button>
                <button class="row-action-btn reject-btn" data-ref="rechazar" title="Rechazar" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>
        </td>
    </tr>
</template>

<!-- Vista previa del archivo adjunto en el formulario -->
<template id="tplFilePreview">
    <div class="file-preview">
        <div class="file-preview__thumb">
            <img data-ref="thumbImg" alt="Vista previa" />
            <span data-ref="thumbPdf">PDF</span>
        </div>
        <div class="file-preview__info">
            <div class="file-preview__name" data-ref="nombre"></div>
            <div class="file-preview__size" data-ref="tamano"></div>
        </div>
        <button class="file-preview__remove" data-ref="quitar" type="button" title="Quitar archivo" aria-label="Quitar archivo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
    </div>
</template>

<!-- Contenido del modal de detalle -->
<template id="tplDetalle">
    <div class="detail-content">
        <div class="detail-grid">
            <div class="detail-item"><small>Día que faltó</small><div class="detail-capitalize" data-ref="fecha"></div></div>
            <div class="detail-item"><small>Estado</small><div><span class="hist-badge" data-ref="estado"></span></div></div>
            <div class="detail-item detail-item--full"><small>Enviada</small><div data-ref="enviada"></div></div>
        </div>
        <div>
            <p class="detail-title">Justificación</p>
            <div class="detail-texto" data-ref="texto"></div>
        </div>
        <div>
            <p class="detail-title">Comprobante</p>
            <div data-ref="comprobante"></div>
        </div>
    </div>
</template>

<!-- Comprobante: mensaje cuando no hay archivo o no está disponible -->
<template id="tplDetalleMuted">
    <div class="detail-muted"></div>
</template>

<!-- Comprobante: imagen -->
<template id="tplDetalleImg">
    <img class="detail-img" alt="Comprobante" />
</template>

<!-- Comprobante: PDF -->
<template id="tplDetallePdf">
    <div class="detail-pdf">
        <div>
            <div class="detail-pdf__name" data-ref="nombre"></div>
            <div class="detail-muted detail-muted--normal" data-ref="info"></div>
        </div>
        <button class="btn btn--outline" data-ref="abrir" type="button">Abrir PDF</button>
    </div>
</template>

<!-- Paginación (mismo diseño que el módulo de calificaciones) -->
<template id="tplPgBtn">
    <button class="pg-btn" type="button"></button>
</template>

<template id="tplPgDots">
    <span class="pg-dots">…</span>
</template>

@section Scripts {
    <script src="~/js/justificaciones.js" asp-append-version="true"></script>
}
