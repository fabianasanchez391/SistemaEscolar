@{
    ViewData["Title"] = "Control de Asistencia";
    ViewData["Page"] = "asistencia";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/asistencia.css" asp-append-version="true" />
}

<!-- ---- Hero (solo visible en la vista de secciones) ---- -->
<div class="module-hero" id="moduleHero">
    <div class="module-hero__left">
        <div class="module-hero__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /><path d="m9 16 2 2 4-4" /></svg>
        </div>
        <div class="module-hero__text">
            <h1>Control de Asistencia</h1>
            <p>Seleccione una sección para registrar y consultar la asistencia de sus estudiantes activos.</p>
        </div>
    </div>
    <div class="module-hero__illustration" aria-hidden="true">
        <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
            <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
            <rect x="52" y="45" width="76" height="95" rx="8" fill="#1a2c56" />
            <rect x="62" y="60" width="56" height="6" rx="3" fill="#eaf1ff" />
            <rect x="62" y="74" width="56" height="6" rx="3" fill="#eaf1ff" />
            <rect x="62" y="88" width="38" height="6" rx="3" fill="#eaf1ff" />
            <circle cx="150" cy="55" r="8" fill="#22b573" />
            <circle cx="150" cy="85" r="8" fill="#f2994a" />
            <circle cx="150" cy="115" r="8" fill="#eb5757" />
        </svg>
    </div>
</div>

<div class="asistencia-layout">

    <!-- =================== COLUMNA PRINCIPAL =================== -->
    <div>

        <!-- ---- VISTA 1: Grid de secciones ---- -->
        <div id="seccionesView">
            <div class="main-actions-bar">
                <label class="filter-search filter-search--inline">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <input type="search" id="seccionSearchInput" placeholder="Buscar sección..." />
                </label>
                <div class="main-actions-bar__right">
                    <span class="results-tag" id="seccionesCount">0 secciones</span>
                </div>
            </div>

            <div class="secciones-grid" id="seccionesGrid"></div>

            <div class="empty-state" id="seccionesEmptyState">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <div>No se encontraron secciones con ese nombre.</div>
            </div>
        </div>

        <!-- ---- VISTA 2: Tabla de asistencia de una sección ---- -->
        <div id="estudiantesView" style="display:none;">

            <div class="main-actions-bar">
                <div class="seccion-actual-group">
                    <button class="btn btn--outline" id="btnVolverSecciones" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 18-6-6 6-6" /></svg>
                        Volver a secciones
                    </button>
                    <div class="seccion-actual" id="seccionActualLabel"></div>
                </div>
                <div class="main-actions-bar__right">
                    <button class="btn btn--success" id="btnGuardarAsistencia" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                        Guardar asistencia
                    </button>
                    <button class="btn btn--outline" id="btnExportSeccion" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                        Exportar asistencia
                    </button>
                </div>
            </div>

            <div class="table-card">
                <div class="table-card__legend">
                    <span class="legend-item"><span class="legend-dot legend-dot--presente"></span>Presente</span>
                    <span class="legend-item"><span class="legend-dot legend-dot--tardia"></span>Tardía</span>
                    <span class="legend-item"><span class="legend-dot legend-dot--ausente"></span>Ausente</span>
                </div>
                <div class="table-scroll">
                    <table class="attendance-table">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Cédula</th>
                                <th>Estado del día</th>
                                <th>Asistencia del mes</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="estudiantesTableBody"></tbody>
                    </table>
                </div>

                <div class="empty-state" id="estudiantesEmptyState">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <div>No se encontraron estudiantes activos con los filtros seleccionados.</div>
                </div>

                <div class="table-pagination">
                    <span id="estudiantesResultsCount">Mostrando 0 de 0 estudiantes</span>
                    <div class="pagination-btns" id="estudiantesPagination"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- =================== PANEL LATERAL =================== -->
    <aside>
        <!-- ---- Fecha y filtros (solo visibles dentro de una sección) ---- -->
        <div class="side-panel" id="filtrosPanel" style="display:none;">
            <div class="side-panel__title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                Fecha de asistencia
            </div>

            <div class="filter-group">
                <label for="fechaAsistenciaInput">Día a registrar</label>
                <input type="date" id="fechaAsistenciaInput" class="date-input" />
            </div>

            <div class="side-panel__title" style="margin-top:4px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16l-6 8v6l-4 2v-8Z" /></svg>
                Filtros de búsqueda
            </div>

            <label class="filter-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <input type="search" id="estudianteSearchInput" placeholder="Buscar por nombre o cédula..." />
            </label>

            <div class="filter-group">
                <label for="estadoFilter">Estado del día</label>
                <select id="estadoFilter">
                    <option value="todos">Todos</option>
                    <option value="presente">Presente</option>
                    <option value="tardia">Tardía</option>
                    <option value="ausente">Ausente</option>
                    <option value="sinRegistrar">Sin registrar</option>
                </select>
            </div>

            <div class="filter-actions">
                <button class="btn btn--outline" id="btnLimpiarFiltros" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
                    Limpiar
                </button>
                <button class="btn btn--success" id="btnAplicarFiltros" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    Aplicar
                </button>
            </div>
        </div>

        <!-- ---- Acciones rápidas ---- -->
        <div class="side-panel" id="accionesRapidasPanel" style="display:none;">
            <div class="side-panel__title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg>
                Acciones rápidas
            </div>
            <button class="btn btn--outline quick-action-btn" id="btnMarcarTodosPresentes" type="button">
                <span class="legend-dot legend-dot--presente"></span> Marcar todos presentes
            </button>
        </div>

        <!-- ---- Recordatorio ---- -->
        <div class="tip-panel" id="tipPanel">
            <button class="tip-panel__close" id="tipCloseBtn" type="button" aria-label="Cerrar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
            <div class="tip-panel__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 3Z" /></svg>
            </div>
            <div class="tip-panel__text">
                <h4>Recuerda</h4>
                <p>Solo se muestran <strong>estudiantes activos</strong>. Puede cambiar el estado de cada uno con un clic y consultar su historial mensual desde "Ver historial".</p>
            </div>
        </div>
    </aside>
</div>

<!-- =================== MODAL: HISTORIAL DE ASISTENCIA =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card" style="max-width:560px;">
        <div class="modal-card__head head-asistencia">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Historial de asistencia</h2>
                    <p id="detailModalSubtitle">Estudiante</p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="historial-resumen" id="historialResumen"></div>
            <div class="historial-list" id="historialList"></div>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
        </div>
    </div>
</div>

<!-- =================== TOAST DE CONFIRMACIÓN =================== -->
<!-- Se muestra únicamente al guardar la asistencia (botón "Guardar asistencia" /
     "Marcar todos presentes", que también persiste el registro). -->
<div class="toast-success-overlay" id="successToast">
    <div class="toast-success-card">
        <div class="toast-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>
        <div class="toast-success-text" id="successToastText">La asistencia se guardó correctamente</div>
    </div>
</div>

@section Scripts {
    <!-- Librería para exportar a Excel con formato (encabezado con color, bordes, anchos de columna) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="~/js/asistencia.js" asp-append-version="true"></script>
}
