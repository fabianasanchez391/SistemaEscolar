@{
    ViewData["Title"] = "Gestión de Calificaciones";
    ViewData["Page"] = "academico";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/calificaciones.css" asp-append-version="true" />
}

<!-- ---- Hero (solo visible en la vista de secciones) ---- -->
<div class="module-hero" id="moduleHero">
    <div class="module-hero__left">
        <div class="module-hero__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /><path d="M22 9v6" /></svg>
        </div>
        <div class="module-hero__text">
            <h1>Gestión de Calificaciones</h1>
            <p>Seleccione una sección para consultar y registrar las calificaciones de sus estudiantes.</p>
        </div>
    </div>
    <div class="module-hero__illustration" aria-hidden="true">
        <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
            <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
            <rect x="55" y="55" width="70" height="90" rx="8" fill="#1a2c56" />
            <rect x="65" y="70" width="50" height="6" rx="3" fill="#eaf1ff" />
            <rect x="65" y="84" width="50" height="6" rx="3" fill="#eaf1ff" />
            <rect x="65" y="98" width="34" height="6" rx="3" fill="#eaf1ff" />
            <circle cx="150" cy="100" r="28" fill="#2f6fed" />
            <path d="M138 100l8 8 16-16" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>
</div>

<div class="calificaciones-layout">

    <!-- =================== COLUMNA PRINCIPAL =================== -->
    <div>

        <!-- ---- VISTA 1: Grid de secciones ---- -->
        <div id="seccionesView">
            <div class="main-actions-bar main-actions-bar--end">
                <span class="results-tag" id="seccionesCount">0 secciones</span>
            </div>

            <div class="secciones-grid" id="seccionesGrid"></div>

            <div class="empty-state" id="seccionesEmptyState">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <div>No se encontraron secciones con ese nombre.</div>
            </div>
        </div>

        <!-- ---- VISTA 2: Tabla de estudiantes de una sección ---- -->
        <div id="estudiantesView" class="is-hidden">

            <div class="main-actions-bar">
                <div class="seccion-actual-group">
                    <button class="btn btn--back" id="btnVolverSecciones" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 18-6-6 6-6" /></svg>
                        Volver a secciones
                    </button>
                    <div class="seccion-actual" id="seccionActualLabel">
                        <span class="seccion-actual__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                        </span>
                        <span class="seccion-actual__name" id="seccionActualNombre"></span>
                    </div>
                </div>
                <div class="main-actions-bar__right">
                    <button class="btn btn--outline" id="btnExportSeccion" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                        Exportar calificaciones
                    </button>
                </div>
            </div>

            <div class="table-card">
                <!-- Barra de búsqueda sobre la tabla -->
                <div class="table-toolbar">
                    <label class="filter-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                        <input type="search" id="estudianteSearchInput" placeholder="Buscar por nombre o cédula..." />
                    </label>
                </div>

                <div class="table-card__legend">
                    <span class="legend-item"><span class="legend-dot legend-dot--bien"></span>Aprobado (≥ 70)</span>
                    <span class="legend-item"><span class="legend-dot legend-dot--riesgo"></span>En riesgo (&lt; 70)</span>
                </div>
                <div class="table-scroll">
                    <table class="grades-table">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Cédula</th>
                                <th class="materia-th materia-th--0">Español</th>
                                <th class="materia-th materia-th--1">Est. Sociales</th>
                                <th class="materia-th materia-th--2">Ciencias</th>
                                <th class="materia-th materia-th--3">Matemáticas</th>
                                <th class="materia-th materia-th--4">Inglés</th>
                                <th>Promedio</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="estudiantesTableBody"></tbody>
                    </table>
                </div>

                <div class="empty-state" id="estudiantesEmptyState">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <div>No se encontraron estudiantes con los filtros seleccionados.</div>
                </div>

                <!-- Pie de tabla: conteo y paginación (fuera de la tabla para que se acomode en responsive) -->
                <div class="table-footer">
                    <span class="pg-info" id="estudiantesResultsCount">Mostrando 0 de 0 estudiantes</span>
                    <div class="pagination-btns" id="estudiantesPagination"></div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- =================== MODAL DETALLE DE CALIFICACIONES =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card modal-card--calif">
        <div class="modal-card__head head-calif">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Detalle de calificaciones</h2>
                    <p><span id="detailModalSubtitle">Estudiante</span> <span class="modal-mode-badge" id="modalModeBadge"></span></p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="materia-tabs" id="materiaTabs"></div>
            <div id="materiaPanels"></div>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
        </div>
    </div>
</div>

<!-- =========================================================
     PLANTILLAS HTML
     El JS solo las clona y rellena con textos; no construye HTML.
     ========================================================= -->
<!-- Tarjeta de sección -->
<template id="tplSeccionCard">
    <div class="seccion-card">
        <div class="seccion-card__accent" data-ref="accent"></div>
        <div class="seccion-card__body">
            <div class="seccion-card__icon" data-ref="icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
            </div>
            <div>
                <div class="seccion-card__name" data-ref="nombre"></div>
            </div>
            <progress class="seccion-card__progress" data-ref="progreso" max="100" value="0"></progress>
            <div class="seccion-card__meta">
                <span data-ref="total"></span>
                <span class="seccion-card__prom" data-ref="prom"></span>
            </div>
        </div>
    </div>
</template>

<!-- Fila de estudiante (una celda por materia, en el mismo orden del encabezado) -->
<template id="tplEstudianteRow">
    <tr>
        <td>
            <div class="user-cell">
                <div class="user-avatar" data-ref="avatar"></div>
                <span class="user-cell__name" data-ref="nombre"></span>
            </div>
        </td>
        <td data-ref="cedula"></td>
        <td class="grade-cell" data-ref="materia0"></td>
        <td class="grade-cell" data-ref="materia1"></td>
        <td class="grade-cell" data-ref="materia2"></td>
        <td class="grade-cell" data-ref="materia3"></td>
        <td class="grade-cell" data-ref="materia4"></td>
        <td class="grade-cell"><span class="prom-pill" data-ref="promedio"></span></td>
        <td>
            <div class="row-actions">
                <button class="row-action-btn view-btn" data-ref="viewBtn" title="Ver notas" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
                <button class="row-action-btn edit-btn" data-ref="editBtn" title="Agregar notas" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                </button>
            </div>
        </td>
    </tr>
</template>

<!-- Pestaña de materia del modal -->
<template id="tplMateriaTab">
    <button class="materia-tab" type="button"></button>
</template>

<!-- Panel de una materia del modal (el JS le agrega los bloques de evaluación) -->
<template id="tplMateriaPanel">
    <div class="materia-panel">
        <div class="materia-panel__promedio">
            <span data-ref="label"></span>
            <strong data-ref="prom"></strong>
        </div>
    </div>
</template>

<!-- Bloque de un tipo de evaluación (exámenes, tareas, etc.) -->
<template id="tplEvalBlock">
    <div class="eval-block">
        <div class="eval-block__head">
            <span class="eval-block__title" data-ref="titulo"></span>
            <span class="eval-block__prom" data-ref="prom"></span>
        </div>
        <div class="eval-notas" data-ref="notas"></div>
        <span class="eval-notas-empty" data-ref="vacio">Sin notas registradas.</span>
        <form class="eval-add-form" data-ref="form">
            <input class="eval-add-form__nota" data-ref="notaInput" type="number" min="0" max="100" step="0.1" placeholder="Nueva nota (0-100)" required />
            <input class="eval-add-form__obs" data-ref="obsInput" type="text" maxlength="200" placeholder="Observación (opcional)" />
            <button type="submit">Agregar</button>
        </form>
    </div>
</template>

<!-- Una nota con su observación (el JS muestra el campo editable o el texto según el modo) -->
<template id="tplEvalNota">
    <div class="eval-nota">
        <span class="eval-nota-chip" data-ref="chip">
            <span data-ref="valor"></span>
            <button class="eval-nota-chip__remove" data-ref="quitar" title="Eliminar nota" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </span>
        <input class="eval-nota-obs" data-ref="obsInput" type="text" maxlength="200" placeholder="Añadir observación..." />
        <span class="eval-nota-obs-text" data-ref="obsTexto"></span>
    </div>
</template>

<!-- Paginación (mismo diseño que el módulo de asistencia) -->
<template id="tplPgBtn">
    <button class="pg-btn" type="button"></button>
</template>

<template id="tplPgDots">
    <span class="pg-dots">…</span>
</template>

@section Scripts {
    <!-- Librería para exportar a Excel con formato (encabezado con color, bordes, anchos de columna) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="~/js/calificaciones.js" asp-append-version="true"></script>
}
