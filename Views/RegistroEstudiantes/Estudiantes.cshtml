@{
    ViewData["Title"] = "Gestión de Estudiantes";
    ViewData["Page"] = "estudiantes";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/estudiantes.css" asp-append-version="true" />
}

<div class="estudiantes-layout">

    <!-- =================== COLUMNA PRINCIPAL =================== -->
    <div>
        <!-- ---- Hero ---- -->
        <div class="module-hero">
            <div class="module-hero__left">
                <div class="module-hero__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                </div>
                <div class="module-hero__text">
                    <h1>Gestión de Estudiantes</h1>
                    <p>Cree las secciones de la escuela y registre dentro de cada una a sus estudiantes.</p>
                </div>
            </div>
            <div class="module-hero__illustration" aria-hidden="true">
                <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
                    <rect x="52" y="48" width="116" height="70" rx="8" fill="#1a2c56" />
                    <rect x="62" y="58" width="96" height="50" rx="4" fill="#eaf1ff" />
                    <path d="M76 96h34M76 84h58M76 72h46" stroke="#2f6fed" stroke-width="5" stroke-linecap="round" />
                    <circle cx="110" cy="132" r="9" fill="#22b573" />
                    <path d="M92 152c2-9 9-14 18-14s16 5 18 14Z" fill="#22b573" />
                </svg>
            </div>
        </div>

        <!-- ---- Tarjetas de resumen: cada una abre su propia vista ---- -->
        <div class="role-stats-row" id="statsRow">
            <div class="role-stat-card role-stat-card--secciones is-active" data-stat="secciones" role="button" tabindex="0">
                <div class="role-stat-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10" /></svg>
                </div>
                <div class="role-stat-card__body">
                    <div class="role-stat-card__label">Secciones creadas</div>
                    <div class="role-stat-card__value" id="statSecciones">0</div>
                    <span class="role-stat-card__link">Ver secciones <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></span>
                </div>
            </div>

            <div class="role-stat-card role-stat-card--estudiantes" data-stat="activo" role="button" tabindex="0">
                <div class="role-stat-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                </div>
                <div class="role-stat-card__body">
                    <div class="role-stat-card__label">Estudiantes activos</div>
                    <div class="role-stat-card__value" id="statEstudiantes">0</div>
                    <span class="role-stat-card__link">Ver detalle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></span>
                </div>
            </div>

            <div class="role-stat-card role-stat-card--inactivos" data-stat="inactivo" role="button" tabindex="0">
                <div class="role-stat-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><circle cx="12" cy="8" r="3.2" /><path d="M5 20c1-3.4 3.6-5.2 7-5.2" /><path d="M15 15l6 6M21 15l-6 6" /></svg>
                </div>
                <div class="role-stat-card__body">
                    <div class="role-stat-card__label">Estudiantes inactivos</div>
                    <div class="role-stat-card__value" id="statInactivos">0</div>
                    <span class="role-stat-card__link">Ver detalle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></span>
                </div>
            </div>
        </div>

        <!-- ---- Barra de filtros ---- -->
        <div class="filters-bar" id="filtersBar">
            <label class="filter-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <input type="search" id="searchInput" placeholder="Buscar sección, docente o estudiante..." />
            </label>

            <!-- Solo aplica en la lista de secciones -->
            <div class="filter-group" id="gradoFilterGroup">
                <label for="gradoFilter">Grado</label>
                <select id="gradoFilter">
                    <option value="todos">Todos</option>
                </select>
            </div>

            <!-- Solo aplica en la lista de estudiantes -->
            <div class="filter-group is-hidden" id="estadoFilterGroup">
                <label for="estadoFilter">Estado</label>
                <select id="estadoFilter">
                    <option value="todos">Todos</option>
                    <option value="activo">Activos</option>
                    <option value="inactivo">Inactivos</option>
                </select>
            </div>

            <div class="filter-actions">
                <button class="btn btn--outline" id="btnLimpiarFiltros" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
                    Limpiar
                </button>
                <button class="btn btn--success" id="btnAplicarFiltros" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    Aplicar
                </button>
            </div>
        </div>

        <!-- =================== VISTA 1: LISTA DE SECCIONES =================== -->
        <div id="seccionesView">
            <div class="main-actions-bar">
                <div class="main-actions-bar__left">
                    <button class="btn btn--violet" id="btnCrearSeccion" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        Crear sección
                    </button>
                    <button class="btn btn--blue" id="qaEstudiante" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        Registrar estudiante
                    </button>
                </div>
                <div class="main-actions-bar__right">
                    <button class="btn btn--outline" id="btnExportSecciones" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                        Exportar secciones
                    </button>
                </div>
            </div>

            <div class="sections-grid" id="seccionesGrid"></div>

            <div class="empty-state empty-state--block" id="seccionesEmpty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18" /></svg>
                <div id="seccionesEmptyText">Todavía no hay secciones. Cree la primera para empezar a registrar estudiantes.</div>
            </div>
        </div>

        <!-- =================== VISTA 2: ESTUDIANTES =================== -->
        <!-- Sirve tanto para una sección concreta como para todas las secciones -->
        <div id="estudiantesView" class="is-hidden">
            <button class="back-btn" id="btnVolverSecciones" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 6-6 6 6 6" /></svg>
                Volver a secciones
            </button>

            <div class="section-header" id="sectionHeader">
                <div class="section-header__left">
                    <div class="section-header__badge" id="viewBadge">5°A</div>
                    <div>
                        <h2 id="viewTitulo">5° - Grupo A</h2>
                        <p id="viewSubtitulo">Docente a cargo: sin asignar</p>
                    </div>
                </div>
                <button class="btn btn--outline" id="btnEditarSeccion" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                    Editar sección
                </button>
            </div>

            <div class="main-actions-bar">
                <div class="main-actions-bar__left">
                    <button class="btn btn--violet" id="qaSeccion" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        Crear sección
                    </button>
                    <button class="btn btn--blue" id="btnRegistrarEstudiante" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        Registrar estudiante
                    </button>
                </div>
                <div class="main-actions-bar__right">
                    <button class="btn btn--outline" id="btnExportEstudiantes" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                        Exportar estudiantes
                    </button>
                </div>
            </div>

            <div class="table-card">
                <div class="table-scroll">
                    <table class="users-table">
                        <!-- Todas las columnas existen; el JS muestra solo las que corresponden a cada vista (data-col).
                             La columna "Sección" solo aparece al ver estudiantes de todas las secciones. -->
                        <thead>
                            <tr>
                                <th data-col="nombre">Nombre</th>
                                <th data-col="cedula">Cédula</th>
                                <th data-col="encargado">Padre o encargado</th>
                                <th data-col="telefono">Celular</th>
                                <th data-col="seccion">Sección</th>
                                <th data-col="estado">Estado</th>
                                <th data-col="acciones">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="estudiantesTableBody"></tbody>
                    </table>
                </div>

                <div class="empty-state" id="estudiantesEmpty">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <div id="estudiantesEmptyText">No hay estudiantes que mostrar.</div>
                </div>

                <!-- Pie de tabla: conteo y paginación (fuera de la tabla para que se acomode en responsive) -->
                <div class="table-footer">
                    <span class="pg-info" id="estudiantesResultsCount">Mostrando 0 de 0 estudiantes</span>
                    <div class="pagination-btns" id="estudiantesPagination"></div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- =================== MODAL SECCIÓN =================== -->
<div class="modal-overlay" id="sectionModal">
    <div class="modal-card modal-card--seccion">
        <div class="modal-card__head head-seccion">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10" /></svg>
                </div>
                <div>
                    <h2 id="sectionModalTitle">Nueva Sección</h2>
                    <p>Defina el grado, el grupo y su docente</p>
                </div>
            </div>
            <button class="modal-close" id="sectionModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="form-row">
                <div class="form-field">
                    <label for="secGrado">Grado</label>
                    <select id="secGrado"></select>
                </div>
                <div class="form-field">
                    <label for="secLetra">Grupo</label>
                    <select id="secLetra"></select>
                </div>
            </div>
            <div class="form-field full">
                <label for="secDocente">Docente a cargo</label>
                <select id="secDocente"></select>
            </div>
            <div class="field-info-box" id="secInfo">
                El nombre de la sección se forma con el grado y el grupo.
            </div>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="sectionModalCancelBtn" type="button">Cancelar</button>
            <button class="btn btn--primary" id="sectionModalSaveBtn" type="button">Guardar sección</button>
        </div>
    </div>
</div>

<!-- =================== MODAL ESTUDIANTE =================== -->
<div class="modal-overlay" id="studentModal">
    <div class="modal-card">
        <div class="modal-card__head head-estudiante">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                </div>
                <div>
                    <h2 id="studentModalTitle">Nuevo Estudiante</h2>
                    <p>Complete los datos del estudiante</p>
                </div>
            </div>
            <button class="modal-close" id="studentModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="form-row">
                <div class="form-field">
                    <label for="eCedula">Cédula</label>
                    <input type="text" id="eCedula" placeholder="1-2345-6789" />
                </div>
                <div class="form-field">
                    <label for="eNombre">Nombre completo</label>
                    <input type="text" id="eNombre" placeholder="Ej. María Rodríguez" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label for="eEncargado">Padre o encargado</label>
                    <input type="text" id="eEncargado" placeholder="Nombre del encargado" />
                </div>
                <div class="form-field">
                    <label for="eTelefono">Celular</label>
                    <input type="tel" id="eTelefono" placeholder="8888-8888" />
                </div>
            </div>
            <div class="form-field full">
                <label for="eSeccion">Sección</label>
                <select id="eSeccion"></select>
            </div>
            <div class="field-info-box" id="eDocenteInfo">
                Seleccione una sección para ver el docente a cargo.
            </div>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="studentModalCancelBtn" type="button">Cancelar</button>
            <button class="btn btn--primary" id="studentModalSaveBtn" type="button">Guardar estudiante</button>
        </div>
    </div>
</div>

<!-- =================== MODAL VER INFORMACIÓN =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card modal-card--detalle">
        <div class="modal-card__head head-estudiante">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Detalle del estudiante</h2>
                    <p id="detailModalSubtitle">Información registrada</p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body" id="detailModalBody"></div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
        </div>
    </div>
</div>

<!-- =================== TOAST DE CONFIRMACIÓN =================== -->
<div class="toast-success-overlay" id="successToast">
    <div class="toast-success-card">
        <div class="toast-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>
        <div class="toast-success-text" id="successToastText">Guardado correctamente</div>
    </div>
</div>

<!-- =========================================================
     PLANTILLAS HTML
     El JS solo las clona y rellena con textos; no construye HTML.
     ========================================================= -->
<!-- Tarjeta de sección -->
<template id="tplSeccionCard">
    <article class="section-card">
        <button class="section-card__edit" data-ref="editBtn" title="Editar sección" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
        </button>
        <div class="section-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
        </div>
        <h3 class="section-card__title" data-ref="titulo"></h3>
        <div class="section-card__docente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.2" /><path d="M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
            <span data-ref="docente"></span>
        </div>
        <progress class="section-card__progress" data-ref="progreso" max="100" value="0"></progress>
        <div class="section-card__footer">
            <span class="section-card__count" data-ref="total"></span>
            <span class="section-card__pill" data-ref="activos"></span>
        </div>
    </article>
</template>

<!-- Fila de estudiante: contiene todas las columnas; el JS oculta las que no aplican a la vista -->
<template id="tplEstudianteRow">
    <tr>
        <td data-col="nombre">
            <div class="user-cell">
                <div class="user-avatar" data-ref="avatar"></div>
                <span class="user-cell__name" data-ref="nombre"></span>
            </div>
        </td>
        <td data-col="cedula" data-ref="cedula"></td>
        <td data-col="encargado" data-ref="encargado"></td>
        <td data-col="telefono" data-ref="telefono"></td>
        <td data-col="seccion"><span class="section-tag" data-ref="seccion"></span></td>
        <td data-col="estado"><button class="status-pill" data-ref="estado" type="button"></button></td>
        <td data-col="acciones">
            <div class="row-actions">
                <button class="row-action-btn edit-btn" data-ref="editBtn" title="Editar" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                </button>
                <button class="row-action-btn view-btn" data-ref="viewBtn" title="Ver información" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
            </div>
        </td>
    </tr>
</template>

<!-- Fila del modal "Ver información" -->
<template id="tplDetalleRow">
    <div class="detail-row">
        <span class="d-label" data-ref="label"></span>
        <span class="d-value" data-ref="value"></span>
    </div>
</template>

<!-- Paginación (mismo diseño que el módulo de asistencia) -->
<template id="tplPgBtn">
    <button class="pg-btn" type="button"></button>
</template>

<template id="tplPgDots">
    <span class="pg-dots">…</span>
</template>

@section Scripts {
    <!-- Librerías para exportar a Excel con formato (encabezado con color, bordes, anchos de columna) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="~/js/estudiantes.js" asp-append-version="true"></script>
}
