@{
    ViewData["Title"] = "Calendario Estudiantil";
    ViewData["Page"] = "calendario";
    Layout = "_Layout";

    // Rol y nombre del usuario con sesión iniciada: "docente" | "directora" | "padre".
    // Ajuste estas líneas a su sistema de autenticación (roles de Identity, claims, etc.).
    // Solo el rol "Padre" es de solo consulta; cualquier otro usuario ve el botón "Agregar evento".
    // IMPORTANTE: al conectar los roles reales, cambie el último valor ("docente") por "padre"
    // para que un usuario sin rol definido no pueda agregar eventos.
    var rolUsuario = User.IsInRole("Directora") ? "directora"
                   : User.IsInRole("Padre") ? "padre"
                   : "docente";
    var nombreUsuario = User.Identity?.Name ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/calendario.css" asp-append-version="true" />
}

<!-- ---- Hero ---- -->
<div class="module-hero">
    <div class="module-hero__left">
        <div class="module-hero__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
        </div>
        <div class="module-hero__text">
            <h1>Calendario Estudiantil</h1>
            <p>Consulte exámenes, matrícula, actividades, feriados y días sin clases. Solo los docentes y la directora pueden agregar eventos, y cada uno muestra quién lo registró.</p>
        </div>
    </div>
    <div class="module-hero__illustration" aria-hidden="true">
        <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
            <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
            <rect x="52" y="38" width="116" height="102" rx="10" fill="#1a2c56" />
            <rect x="52" y="38" width="116" height="26" rx="10" fill="#2f6fed" />
            <rect x="68" y="30" width="6" height="16" rx="3" fill="#eaf1ff" />
            <rect x="146" y="30" width="6" height="16" rx="3" fill="#eaf1ff" />
            <rect x="66" y="76" width="16" height="12" rx="3" fill="#eaf1ff" />
            <rect x="92" y="76" width="16" height="12" rx="3" fill="#eaf1ff" />
            <rect x="118" y="76" width="16" height="12" rx="3" fill="#f2994a" />
            <rect x="66" y="98" width="16" height="12" rx="3" fill="#eaf1ff" />
            <rect x="92" y="98" width="16" height="12" rx="3" fill="#22b573" />
            <rect x="118" y="98" width="16" height="12" rx="3" fill="#eaf1ff" />
            <rect x="144" y="98" width="16" height="12" rx="3" fill="#eb5757" />
        </svg>
    </div>
</div>

<div class="cal-page" id="calPage" data-rol="@rolUsuario" data-nombre="@nombreUsuario">

    <div class="cal-layout">

        <!-- =================== CALENDARIO =================== -->
        <section class="table-card cal-card">
            <div class="cal-head">
                <div class="cal-nav">
                    <button class="cal-nav__btn" id="btnMesAnterior" type="button" aria-label="Mes anterior">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                    </button>
                    <h2 class="cal-title" id="calTitulo">Mes</h2>
                    <button class="cal-nav__btn" id="btnMesSiguiente" type="button" aria-label="Mes siguiente">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                    </button>
                    <button class="btn btn--outline btn--sm" id="btnHoy" type="button">Hoy</button>
                </div>
                <button class="btn btn--primary" id="btnNuevoEvento" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Agregar evento
                </button>
            </div>

            <div class="table-toolbar">
                <div class="chip-group" id="tipoChips">
                    <button class="chip is-active" data-tipo="todos" type="button">Todos</button>
                    <button class="chip" data-tipo="examen" type="button"><span class="chip-dot ev--examen"></span>Exámenes</button>
                    <button class="chip" data-tipo="matricula" type="button"><span class="chip-dot ev--matricula"></span>Matrícula</button>
                    <button class="chip" data-tipo="actividad" type="button"><span class="chip-dot ev--actividad"></span>Actividades</button>
                    <button class="chip" data-tipo="feriado" type="button"><span class="chip-dot ev--feriado"></span>Feriados</button>
                    <button class="chip" data-tipo="sinclases" type="button"><span class="chip-dot ev--sinclases"></span>Sin clases</button>
                    <button class="chip" data-tipo="reunion" type="button"><span class="chip-dot ev--reunion"></span>Reuniones</button>
                    <button class="chip" data-tipo="otro" type="button"><span class="chip-dot ev--otro"></span>Otros</button>
                </div>
            </div>

            <div class="cal-weekdays">
                <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
            </div>
            <div class="cal-grid" id="calGrid"></div>
        </section>

        <!-- =================== PRÓXIMOS EVENTOS =================== -->
        <aside class="table-card proximos-card">
            <div class="side-head">
                <h2>Próximos eventos</h2>
                <p>Lo que viene en el calendario</p>
            </div>
            <div class="proximos-list" id="proximosList"></div>
            <div class="empty-state" id="proximosEmpty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                <div>No hay eventos próximos.</div>
            </div>
        </aside>
    </div>
</div>

<!-- =================== MODAL: EVENTOS DEL DÍA =================== -->
<div class="modal-overlay" id="dayModal">
    <div class="modal-card">
        <div class="modal-card__head head-calendario">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                </div>
                <div>
                    <h2 class="detail-capitalize" id="dayModalTitle">Día</h2>
                    <p id="dayModalSubtitle">Eventos</p>
                </div>
            </div>
            <button class="modal-close" id="dayModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="dia-lista" id="diaLista"></div>
            <div class="detail-muted" id="diaVacio">No hay eventos registrados para este día.</div>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="dayModalCloseBtn2" type="button">Cerrar</button>
            <button class="btn btn--primary is-hidden" id="btnDiaAgregar" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Agregar evento este día
            </button>
        </div>
    </div>
</div>

<!-- =================== MODAL: AGREGAR EVENTO =================== -->
<div class="modal-overlay" id="formModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-calendario">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4" /></svg>
                </div>
                <div>
                    <h2>Agregar evento</h2>
                    <p>Los campos marcados con * son obligatorios</p>
                </div>
            </div>
            <button class="modal-close" id="formModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <div class="autor-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                <span>Se registrará a nombre de <strong id="formAutorNombre"></strong></span>
            </div>

            <form id="evForm" class="ev-form" novalidate>
                <div class="field">
                    <label for="evTitulo">Título del evento *</label>
                    <input type="text" id="evTitulo" class="field-input" placeholder="Ej: Examen de Matemáticas" maxlength="80" autocomplete="off" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="evTipo">Tipo de evento *</label>
                        <select id="evTipo" class="field-input">
                            <option value="examen">Examen</option>
                            <option value="matricula">Matrícula</option>
                            <option value="actividad">Actividad</option>
                            <option value="feriado">Feriado</option>
                            <option value="sinclases">Sin clases</option>
                            <option value="reunion">Reunión</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="evDirigido">Dirigido a</label>
                        <select id="evDirigido" class="field-input">
                            <option value="todas">Toda la escuela</option>
                            <option value="1° - Grupo A">1° - Grupo A</option>
                            <option value="1° - Grupo B">1° - Grupo B</option>
                            <option value="4° - Grupo A">4° - Grupo A</option>
                            <option value="5° - Grupo A">5° - Grupo A</option>
                        </select>
                    </div>
                </div>

                <div class="field-row field-row--3">
                    <div class="field">
                        <label for="evInicio">Fecha *</label>
                        <input type="date" id="evInicio" class="field-input" />
                    </div>
                    <div class="field">
                        <label for="evFin">Hasta (opcional)</label>
                        <input type="date" id="evFin" class="field-input" />
                    </div>
                    <div class="field">
                        <label for="evHora">Hora (opcional)</label>
                        <input type="time" id="evHora" class="field-input" />
                    </div>
                </div>
                <small class="field-hint">Use "Hasta" para eventos de varios días, como la matrícula o las vacaciones.</small>

                <div class="field">
                    <label for="evDescripcion">Descripción (opcional)</label>
                    <textarea id="evDescripcion" class="field-input field-textarea" rows="3" maxlength="500" placeholder="Detalles que los padres y estudiantes deban saber..."></textarea>
                    <small class="field-hint field-hint--right"><span id="evContador">0</span>/500</small>
                </div>

                <div class="form-error is-hidden" id="evError" role="alert"></div>
            </form>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="btnCancelar" type="button">Cancelar</button>
            <button class="btn btn--success" id="btnGuardar" type="submit" form="evForm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                Guardar evento
            </button>
        </div>
    </div>
</div>

<!-- =================== MODAL: DETALLE DEL EVENTO =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-calendario">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Evento</h2>
                    <p id="detailModalSubtitle">Tipo</p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body" id="detailBody"></div>
        <div class="modal-card__foot">
            <button class="btn btn--danger is-hidden" id="btnDetalleEliminar" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v5M14 11v5" /></svg>
                Eliminar evento
            </button>
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
        </div>
    </div>
</div>

<!-- =================== TOAST DE CONFIRMACIÓN =================== -->
<div class="toast-success-overlay" id="successToast">
    <div class="toast-success-card">
        <div class="toast-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <div class="toast-success-text" id="successToastText">El evento se agregó correctamente</div>
    </div>
</div>

<!-- =========================================================
     PLANTILLAS HTML
     El JS solo las clona y rellena con textos; no construye HTML.
     ========================================================= -->

<!-- Celda de un día del calendario -->
<template id="tplDiaCelda">
    <div class="cal-day" role="button" tabindex="0">
        <span class="cal-day__num" data-ref="num"></span>
        <div class="cal-day__events" data-ref="eventos"></div>
        <span class="cal-day__more" data-ref="mas"></span>
    </div>
</template>

<!-- Etiqueta de un evento dentro de la celda -->
<template id="tplEventoChip">
    <button class="cal-chip" type="button"><span data-ref="texto"></span></button>
</template>

<!-- Evento en la lista de próximos eventos -->
<template id="tplProximo">
    <button class="proximo" type="button">
        <div class="proximo__fecha" data-ref="fecha">
            <strong data-ref="dia"></strong>
            <span data-ref="mes"></span>
        </div>
        <div class="proximo__info">
            <div class="proximo__titulo" data-ref="titulo"></div>
            <div class="proximo__meta">
                <span class="tipo-badge" data-ref="tipo"></span>
                <span class="proximo__autor" data-ref="autor"></span>
            </div>
        </div>
    </button>
</template>

<!-- Evento en el modal de eventos del día -->
<template id="tplDiaEvento">
    <button class="dia-evento" type="button">
        <div class="dia-evento__top">
            <span class="dia-evento__titulo" data-ref="titulo"></span>
            <span class="tipo-badge" data-ref="tipo"></span>
        </div>
        <div class="dia-evento__meta" data-ref="meta"></div>
        <div class="dia-evento__autor" data-ref="autor"></div>
    </button>
</template>

<!-- Contenido del modal de detalle -->
<template id="tplDetalle">
    <div class="detail-content">
        <div class="detail-grid">
            <div class="detail-item"><small>Tipo</small><div><span class="tipo-badge" data-ref="tipo"></span></div></div>
            <div class="detail-item"><small>Dirigido a</small><div data-ref="dirigido"></div></div>
            <div class="detail-item detail-item--full"><small>Fecha</small><div class="detail-capitalize" data-ref="fecha"></div></div>
            <div class="detail-item detail-item--full"><small>Hora</small><div data-ref="hora"></div></div>
        </div>
        <div>
            <p class="detail-title">Descripción</p>
            <div class="detail-texto" data-ref="descripcion"></div>
        </div>
        <div>
            <p class="detail-title">Agregado por</p>
            <div class="autor-box">
                <div class="user-avatar" data-ref="autorAvatar"></div>
                <div>
                    <div class="autor-box__nombre" data-ref="autorNombre"></div>
                    <div class="autor-box__meta" data-ref="autorMeta"></div>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/calendario.js" asp-append-version="true"></script>
}
