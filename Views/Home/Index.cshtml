@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

<!-- =================== HERO + FECHA =================== -->
<section class="hero-row">
    <div class="hero-card">
        <div class="hero-card__text">
            <h1>¡Hola, Fabiana!</h1>
            <p>
                Bienvenida al sistema de gestión académica de la Escuela El Valle.
                Aquí puedes mantener un control completo de la información de tus
                estudiantes y actividades.
            </p>
        </div>
        <div class="hero-card__illustration" aria-hidden="true">
            <svg viewBox="0 0 240 190" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="roofGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#4c86f5" />
                        <stop offset="100%" stop-color="#2f6fed" />
                    </linearGradient>
                    <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ffffff" />
                        <stop offset="100%" stop-color="#f4f6fb" />
                    </linearGradient>
                </defs>

                <!-- sol -->
                <circle cx="200" cy="34" r="18" fill="#fdf0da" />
                <circle cx="200" cy="34" r="12" fill="#f5a623" />

                <!-- nubes -->
                <g fill="#ffffff" stroke="#e7eaf3" stroke-width="1">
                    <ellipse cx="40" cy="30" rx="18" ry="10" />
                    <ellipse cx="55" cy="26" rx="14" ry="9" />
                    <ellipse cx="28" cy="26" rx="12" ry="8" />
                </g>

                <!-- suelo -->
                <ellipse cx="120" cy="178" rx="110" ry="9" fill="#dbe6fb" />

                <!-- árbol izquierdo -->
                <rect x="20" y="140" width="8" height="26" rx="2" fill="#a9765a" />
                <circle cx="24" cy="128" r="20" fill="#7cc590" />
                <circle cx="12" cy="138" r="14" fill="#8fce9f" />
                <circle cx="36" cy="138" r="14" fill="#8fce9f" />

                <!-- árbol derecho -->
                <rect x="206" y="146" width="7" height="22" rx="2" fill="#a9765a" />
                <circle cx="209" cy="134" r="17" fill="#7cc590" />
                <circle cx="199" cy="143" r="12" fill="#8fce9f" />
                <circle cx="219" cy="143" r="12" fill="#8fce9f" />

                <!-- cuerpo del edificio -->
                <rect x="58" y="78" width="124" height="92" rx="6" fill="url(#wallGrad)" stroke="#b9cdf0" stroke-width="2" />

                <!-- techo -->
                <polygon points="50,80 120,38 190,80" fill="url(#roofGrad)" />
                <rect x="46" y="78" width="148" height="8" rx="3" fill="#2f6fed" />

                <!-- asta y bandera -->
                <rect x="117" y="14" width="4" height="26" fill="#8792a6" />
                <polygon points="121,14 141,20 121,26" fill="#f5a623" />

                <!-- puerta -->
                <rect x="106" y="128" width="28" height="42" rx="3" fill="#2f6fed" />
                <circle cx="128" cy="150" r="1.8" fill="#fff" />

                <!-- ventanas -->
                <rect x="70" y="94" width="20" height="20" rx="3" fill="#dbe6fb" stroke="#b9cdf0" />
                <rect x="150" y="94" width="20" height="20" rx="3" fill="#dbe6fb" stroke="#b9cdf0" />
                <rect x="70" y="128" width="18" height="18" rx="3" fill="#dbe6fb" stroke="#b9cdf0" />
                <rect x="152" y="128" width="18" height="18" rx="3" fill="#dbe6fb" stroke="#b9cdf0" />

                <!-- insignia sobre la puerta -->
                <circle cx="120" cy="108" r="10" fill="#f5a623" />
                <path d="M114 108l4 4 8-8" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    </div>

    <div class="date-card">
        <div class="date-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M8 3v4M16 3v4" /></svg>
        </div>
        <h2>Lunes, 25 de agosto de 2025</h2>
        <p>¡Que tengas un excelente día!</p>
    </div>
</section>

<!-- =================== TARJETAS DE MÉTRICAS =================== -->
<section class="stats-row">
    <article class="stat-card stat-card--blue">
        <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.2" /><path d="M3 20c1-3.4 3.6-5.2 6-5.2s5 1.8 6 5.2" /><circle cx="17" cy="9" r="2.6" /><path d="M15.5 14.3c2.2.2 4 1.8 4.7 4.2" /></svg>
        </div>
        <div class="stat-card__label">Total de estudiantes</div>
        <div class="stat-card__value">128</div>
        <span class="stat-card__delta up">↑ 5 nuevos este mes</span>
    </article>

    <article class="stat-card stat-card--teal">
        <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.2" /><path d="M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
        </div>
        <div class="stat-card__label">Docentes activos</div>
        <div class="stat-card__value">12</div>
        <span class="stat-card__delta flat">0 cambios este mes</span>
    </article>

    <article class="stat-card stat-card--purple">
        <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3" /><circle cx="16" cy="9" r="2.4" /><path d="M3 19c.9-3 3.3-4.8 6-4.8s5.1 1.8 6 4.8" /><path d="M15 14.6c2 .3 3.6 1.8 4.2 3.9" /></svg>
        </div>
        <div class="stat-card__label">Padres registrados</div>
        <div class="stat-card__value">96</div>
        <span class="stat-card__delta up">↑ 3 nuevos este mes</span>
    </article>

    <article class="stat-card stat-card--orange">
        <div class="stat-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M8 3v4M16 3v4" /><path d="m9.5 15 1.7 1.7L14.5 13" /></svg>
        </div>
        <div class="stat-card__label">Citas pendientes</div>
        <div class="stat-card__value">5</div>
        <span class="stat-card__delta down">↓ 2 menos que ayer</span>
    </article>
</section>

<!-- =================== ASISTENCIA + RENDIMIENTO =================== -->
<section class="panels-row">
    <div class="panel panel--split">
        <div style="width:100%">
            <div class="panel__head">
                <span class="panel__title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M8 3v4M16 3v4" /></svg>
                    Resumen de Asistencia
                </span>

            </div>

            <div class="donut-row">
                <div class="donut" style="--donut-gradient: conic-gradient(var(--green-600) 0% 92%, var(--yellow-500) 92% 96%, var(--red-500) 96% 100%);">
                    <div class="donut__label">
                        <div class="donut__value">92%</div>
                        <div class="donut__caption">Asistencia</div>
                    </div>
                </div>

                <ul class="legend">
                    <li class="legend__row"><span><span class="dot" style="background:var(--green-600)"></span>Presentes</span><span class="value">118</span></li>
                    <li class="legend__row"><span><span class="dot" style="background:var(--yellow-500)"></span>Tardías</span><span class="value">6</span></li>
                    <li class="legend__row"><span><span class="dot" style="background:var(--red-500)"></span>Ausentes</span><span class="value">4</span></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="panel panel--split">
        <div style="width:100%">
            <div class="panel__head">
                <span class="panel__title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M12 20V4M20 20v-7" /></svg>
                    Rendimiento Académico
                </span>

            </div>

            <div class="donut-row">
                <div class="donut" style="--donut-gradient: conic-gradient(var(--teal-600) 0% 87%, var(--line) 87% 100%);">
                    <div class="donut__label">
                        <div class="donut__value">87%</div>
                        <div class="donut__caption">Promedio</div>
                    </div>
                </div>

                <div class="bar-list" style="width:100%">
                    <div>
                        <div class="bar-row__top"><span>Matemáticas</span><span class="pct">90%</span></div>
                        <div class="bar-track"><div class="bar-fill" style="width:90%"></div></div>
                    </div>
                    <div>
                        <div class="bar-row__top"><span>Español</span><span class="pct">88%</span></div>
                        <div class="bar-track"><div class="bar-fill" style="width:88%"></div></div>
                    </div>
                    <div>
                        <div class="bar-row__top"><span>Ciencias</span><span class="pct">85%</span></div>
                        <div class="bar-track"><div class="bar-fill" style="width:85%"></div></div>
                    </div>
                    <div>
                        <div class="bar-row__top"><span>Estudios Sociales</span><span class="pct">82%</span></div>
                        <div class="bar-track"><div class="bar-fill" style="width:82%"></div></div>
                    </div>
                    <div>
                        <div class="bar-row__top"><span>Inglés</span><span class="pct">80%</span></div>
                        <div class="bar-track"><div class="bar-fill" style="width:80%"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =================== ACTIVIDADES + AVISOS =================== -->
<section class="panels-row">
    <div class="panel">
        <div class="panel__head">
            <span class="panel__title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M8 3v4M16 3v4" /></svg>
                Próximas Actividades
            </span>
            <span class="panel__link">Ver todas</span>
        </div>

        <div class="list-rows">
            <div class="list-row">
                <div class="date-chip"><span class="day">26</span><span class="mon">Ago</span></div>
                <div class="list-row__body">
                    <div class="list-row__title">Examen de Matemáticas</div>
                    <div class="list-row__sub">5° Grado - Grupo A</div>
                </div>
                <span class="tag tag--green">Programado</span>
            </div>

            <div class="list-row">
                <div class="date-chip"><span class="day">28</span><span class="mon">Ago</span></div>
                <div class="list-row__body">
                    <div class="list-row__title">Reunión de padres</div>
                    <div class="list-row__sub">Salón multiuso</div>
                </div>
                <span class="tag tag--blue">Cita</span>
            </div>

            <div class="list-row">
                <div class="date-chip"><span class="day">30</span><span class="mon">Ago</span></div>
                <div class="list-row__body">
                    <div class="list-row__title">Entrega de tareas</div>
                    <div class="list-row__sub">4° Grado - Grupo B</div>
                </div>
                <span class="tag tag--purple">Tarea</span>
            </div>

            <div class="list-row">
                <div class="date-chip"><span class="day">02</span><span class="mon">Sep</span></div>
                <div class="list-row__body">
                    <div class="list-row__title">Feriado: Día de la Independencia</div>
                    <div class="list-row__sub">Todo el centro educativo</div>
                </div>
                <span class="tag tag--orange">Feriado</span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel__head">
            <span class="panel__title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11v2a2 2 0 0 0 2 2h1l4 4v-4h7a2 2 0 0 0 2-2v-2" /><path d="M3 11 12 5l9 6" /></svg>
                Avisos Institucionales
            </span>
            <span class="panel__link">Ver todos</span>
        </div>

        <div class="list-rows">
            <div class="list-row">
                <div class="icon-chip icon-chip--blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
                </div>
                <div class="list-row__body">
                    <div class="list-row__title">Inicio de matrícula 2026</div>
                    <div class="list-row__sub">La matrícula para el próximo año lectivo estará disponible...</div>
                </div>
                <span class="list-row__date">20 ago. 2025</span>
            </div>

            <div class="list-row">
                <div class="icon-chip icon-chip--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v3M5 8l2 1M19 8l-2 1M6 14c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M4 14h16l-1.5 6h-13z" /></svg>
                </div>
                <div class="list-row__body">
                    <div class="list-row__title">Celebración del Día del Niño</div>
                    <div class="list-row__sub">Se llevará a cabo el próximo 1 de setiembre en el salón...</div>
                </div>
                <span class="list-row__date">18 ago. 2025</span>
            </div>

            <div class="list-row">
                <div class="icon-chip icon-chip--teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
                </div>
                <div class="list-row__body">
                    <div class="list-row__title">Horario de clases</div>
                    <div class="list-row__sub">Recuerde que el horario de clases se mantiene igual...</div>
                </div>
                <span class="list-row__date">15 ago. 2025</span>
            </div>

            <div class="list-row">
                <div class="icon-chip icon-chip--purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>
                </div>
                <div class="list-row__body">
                    <div class="list-row__title">Entrega de informes</div>
                    <div class="list-row__sub">Los informes académicos estarán disponibles a partir del...</div>
                </div>
                <span class="list-row__date">12 ago. 2025</span>
            </div>
        </div>
    </div>
</section>

<!-- =================== ACCESOS RÁPIDOS =================== -->
<section class="actions-row">
    <a class="action-card action-card--green" asp-controller="Usuarios" asp-action="Index">
        <div class="action-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.2" /><path d="M3 20c1-3.4 3.6-5.2 6-5.2s5 1.8 6 5.2" /><path d="M17 8v4M15 10h4" /></svg>
        </div>
        <div class="action-card__body">
            <h3>Gestionar Estudiantes</h3>
            <p>Agregar, editar o consultar estudiantes.</p>
        </div>
        <span class="action-card__chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </span>
    </a>

    <a class="action-card action-card--blue" asp-controller="Calendario" asp-action="Index">
        <div class="action-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M8 3v4M16 3v4" /></svg>
        </div>
        <div class="action-card__body">
            <h3>Ver Calendario</h3>
            <p>Revisa las fechas importantes del ciclo lectivo.</p>
        </div>
        <span class="action-card__chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </span>
    </a>

    <a class="action-card action-card--teal" asp-controller="Reportes" asp-action="Index">
        <div class="action-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>
        </div>
        <div class="action-card__body">
            <h3>Generar Reportes</h3>
            <p>Obtén reportes de asistencia, calificaciones y más.</p>
        </div>
        <span class="action-card__chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </span>
    </a>

    <a class="action-card action-card--purple" asp-controller="Mensajes" asp-action="Index">
        <div class="action-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v11H8l-4 4Z" /></svg>
        </div>
        <div class="action-card__body">
            <h3>Enviar Mensajes</h3>
            <p>Comunícate con padres y estudiantes.</p>
        </div>
        <span class="action-card__chevron">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </span>
    </a>
</section>
