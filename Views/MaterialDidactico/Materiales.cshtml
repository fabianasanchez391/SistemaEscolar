@{
    ViewData["Title"] = "Materiales de Apoyo";
    ViewData["Page"] = "materiales";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/materiales.css" asp-append-version="true" />
}

<!-- ---- Hero (solo visible en la vista de secciones) ---- -->
<div class="module-hero" id="moduleHero">
    <div class="module-hero__left">
        <div class="module-hero__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
        </div>
        <div class="module-hero__text">
            <h1>Materiales de Apoyo</h1>
            <p>Seleccione una sección para subir o consultar material de apoyo, prácticas para exámenes, documentos, imágenes y videos de YouTube.</p>
        </div>
    </div>
    <div class="module-hero__illustration" aria-hidden="true">
        <svg viewBox="0 0 220 170" xmlns="http://www.w3.org/2000/svg">
            <circle cx="110" cy="85" r="80" fill="#eaf1ff" />
            <rect x="58" y="52" width="104" height="78" rx="10" fill="#1a2c56" />
            <rect x="58" y="44" width="44" height="16" rx="6" fill="#2f6fed" />
            <rect x="74" y="78" width="72" height="6" rx="3" fill="#eaf1ff" />
            <rect x="74" y="92" width="72" height="6" rx="3" fill="#eaf1ff" />
            <rect x="74" y="106" width="44" height="6" rx="3" fill="#eaf1ff" />
            <circle cx="152" cy="118" r="16" fill="#22b573" />
            <path d="M152 126v-16m0 0-6 6m6-6 6 6" stroke="#fff" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>
</div>

<div class="materiales-layout">

    <!-- Selector de vista (solo demostración: en producción el rol sale del inicio de sesión) -->
    <div class="role-bar">
        <span class="role-bar__label">Vista de demostración:</span>
        <div class="role-switch" id="roleSwitch">
            <button class="role-btn is-active" data-rol="docente" type="button">Docente</button>
            <button class="role-btn" data-rol="padre" type="button">Padre de familia</button>
        </div>
    </div>

    <!-- ---- VISTA 1: Grid de secciones ---- -->
    <div id="seccionesView">
        <div class="main-actions-bar main-actions-bar--end">
            <span class="results-tag" id="seccionesCount">0 secciones</span>
        </div>

        <div class="secciones-grid" id="seccionesGrid"></div>
    </div>

    <!-- ---- VISTA 2: Materiales de una sección ---- -->
    <div id="materialesView" class="is-hidden">

        <div class="main-actions-bar">
            <div class="seccion-actual-group">
                <button class="btn btn--back" id="btnVolverSecciones" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 18-6-6 6-6" /></svg>
                    Volver a secciones
                </button>
                <div class="seccion-actual">
                    <span class="seccion-actual__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 9 12 5 2 9l10 4 10-4Z" /><path d="M6 11v4c0 1.5 2.7 3.5 6 3.5s6-2 6-3.5v-4" /></svg>
                    </span>
                    <span class="seccion-actual__name" id="seccionActualNombre"></span>
                </div>
            </div>
            <div class="main-actions-bar__right">
                <button class="btn btn--primary" id="btnSubirMaterial" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Subir material
                </button>
            </div>
        </div>

        <section class="table-card">
            <div class="mat-card-head">
                <h2>Materiales compartidos</h2>
                <p id="matResultsTag">0 materiales</p>
            </div>

            <div class="table-toolbar">
                <label class="filter-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <input type="search" id="matSearchInput" placeholder="Buscar por título, materia o comentario..." />
                </label>
                <div class="chip-group" id="tipoChips">
                    <button class="chip is-active" data-tipo="todos" type="button">Todos <span id="chipTodos">0</span></button>
                    <button class="chip" data-tipo="pdf" type="button">PDF <span id="chipPdf">0</span></button>
                    <button class="chip" data-tipo="word" type="button">Word <span id="chipWord">0</span></button>
                    <button class="chip" data-tipo="imagen" type="button">Imágenes <span id="chipImagen">0</span></button>
                    <button class="chip" data-tipo="youtube" type="button">Videos <span id="chipYoutube">0</span></button>
                </div>
            </div>

            <div class="materiales-grid" id="materialesGrid"></div>

            <div class="empty-state" id="matEmptyState">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <div>No hay materiales que coincidan con los filtros.</div>
            </div>

            <!-- Pie de tabla: conteo y paginación -->
            <div class="table-footer">
                <span class="pg-info" id="matCountInfo">Mostrando 0 de 0 materiales</span>
                <div class="pagination-btns" id="matPagination"></div>
            </div>
        </section>
    </div>
</div>

<!-- =================== MODAL: SUBIR MATERIAL =================== -->
<div class="modal-overlay" id="formModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-material">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></svg>
                </div>
                <div>
                    <h2>Subir material</h2>
                    <p id="formModalSubtitle">Los campos marcados con * son obligatorios</p>
                </div>
            </div>
            <button class="modal-close" id="formModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body">
            <form id="matForm" class="mat-form" novalidate>
                <div class="field">
                    <label for="matTitulo">Título del material *</label>
                    <input type="text" id="matTitulo" class="field-input" placeholder="Ej: Práctica para el examen de fracciones" maxlength="80" autocomplete="off" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="matMateria">Materia</label>
                        <select id="matMateria" class="field-input">
                            <option value="General">General</option>
                            <option value="Español">Español</option>
                            <option value="Estudios Sociales">Estudios Sociales</option>
                            <option value="Ciencias">Ciencias</option>
                            <option value="Matemáticas">Matemáticas</option>
                            <option value="Inglés">Inglés</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="matCategoria">Categoría</label>
                        <select id="matCategoria" class="field-input">
                            <option value="Material de apoyo">Material de apoyo</option>
                            <option value="Práctica para examen">Práctica para examen</option>
                            <option value="Tarea">Tarea</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>

                <div class="field">
                    <div class="field-label">¿Qué desea compartir? *</div>
                    <div class="opcion-group">
                        <label class="opcion">
                            <input type="radio" name="materialOrigen" value="archivo" checked />
                            <span class="opcion__card">
                                <span class="opcion__title">Archivo</span>
                                <span class="opcion__sub">PDF, Word o imagen</span>
                            </span>
                        </label>
                        <label class="opcion">
                            <input type="radio" name="materialOrigen" value="youtube" />
                            <span class="opcion__card">
                                <span class="opcion__title">Enlace de YouTube</span>
                                <span class="opcion__sub">Video de apoyo</span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Origen: archivo -->
                <div class="field" id="campoArchivo">
                    <label>Archivo *</label>
                    <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Subir archivo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></svg>
                        <div class="dropzone__title">Arrastre el archivo aquí o <span>búsquelo</span></div>
                        <div class="dropzone__sub">PDF, Word (DOC, DOCX), JPG, PNG o WEBP · máximo 5 MB</div>
                    </div>
                    <input type="file" id="matArchivo" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp" hidden />

                    <!-- Aquí el JS inserta la vista previa del archivo (plantilla tplFilePreview) -->
                    <div id="filePreview" class="is-hidden"></div>
                </div>

                <!-- Origen: enlace de YouTube -->
                <div class="field is-hidden" id="campoYoutube">
                    <label for="matUrl">Enlace de YouTube *</label>
                    <input type="url" id="matUrl" class="field-input" placeholder="https://www.youtube.com/watch?v=..." maxlength="200" autocomplete="off" />
                    <small class="field-hint">Se aceptan enlaces de youtube.com y youtu.be</small>
                </div>

                <div class="field">
                    <label for="matComentario">Comentario sobre el material (opcional)</label>
                    <textarea id="matComentario" class="field-input field-textarea" rows="3" maxlength="500" placeholder="Ej: Resuelvan las páginas 1 a 3 antes del examen del viernes..."></textarea>
                    <small class="field-hint field-hint--right"><span id="matContador">0</span>/500</small>
                </div>

                <div class="form-error is-hidden" id="matError" role="alert"></div>
            </form>
        </div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="btnCancelar" type="button">Cancelar</button>
            <button class="btn btn--success" id="btnEnviar" type="submit" form="matForm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
                Publicar material
            </button>
        </div>
    </div>
</div>

<!-- =================== MODAL: DETALLE =================== -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-card modal-card--md">
        <div class="modal-card__head head-material">
            <div class="modal-card__head-info">
                <div class="modal-card__head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
                </div>
                <div>
                    <h2 id="detailModalTitle">Material</h2>
                    <p id="detailModalSubtitle">Sección</p>
                </div>
            </div>
            <button class="modal-close" id="detailModalCloseBtn" type="button" aria-label="Cerrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-card__body" id="detailBody"></div>
        <div class="modal-card__foot">
            <button class="btn btn--outline" id="detailModalCloseBtn2" type="button">Cerrar</button>
            <button class="btn btn--success is-hidden" id="btnDetalleAccion" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                <span id="btnDetalleAccionTexto">Descargar</span>
            </button>
        </div>
    </div>
</div>

<!-- =================== TOAST DE CONFIRMACIÓN =================== -->
<div class="toast-success-overlay" id="successToast">
    <div class="toast-success-card">
        <div class="toast-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <div class="toast-success-text" id="successToastText">El material se publicó correctamente</div>
    </div>
</div>

<!-- =========================================================
     PLANTILLAS HTML
     El JS solo las clona y rellena con textos; no construye HTML.
     ========================================================= -->
<!-- Tarjeta de sección -->
<template id="tplSeccionCard">
    <div class="seccion-card">
        <div class="seccion-card__accent" data-ref="accent"></div>
        <div class="seccion-card__body">
            <div class="seccion-card__icon" data-ref="icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
            </div>
            <div>
                <div class="seccion-card__name" data-ref="nombre"></div>
            </div>
            <div class="seccion-card__meta">
                <span data-ref="total"></span>
                <span class="seccion-card__chip" data-ref="chip"></span>
            </div>
        </div>
    </div>
</template>

<!-- Tarjeta de material -->
<template id="tplMaterialCard">
    <article class="material-card">
        <div class="material-card__thumb" data-ref="thumb">
            <img data-ref="thumbImg" alt="" />
            <span class="material-card__icon" data-ref="thumbIcon"></span>
            <span class="material-card__play" data-ref="play">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7Z" /></svg>
            </span>
        </div>
        <div class="material-card__body">
            <div class="material-card__badges">
                <span class="tipo-badge" data-ref="tipo"></span>
                <span class="cat-badge" data-ref="categoria"></span>
            </div>
            <h3 class="material-card__title" data-ref="titulo"></h3>
            <div class="material-card__materia" data-ref="materia"></div>
            <p class="material-card__comment" data-ref="comentario"></p>
            <div class="material-card__meta" data-ref="meta"></div>
        </div>
        <div class="material-card__actions">
            <button class="btn btn--outline btn--sm" data-ref="ver" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                Ver
            </button>
            <button class="btn btn--outline btn--sm" data-ref="accion" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
                <span data-ref="accionTexto">Descargar</span>
            </button>
            <button class="row-action-btn delete-btn" data-ref="eliminar" title="Eliminar material" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v5M14 11v5" /></svg>
            </button>
        </div>
    </article>
</template>

<!-- Vista previa del archivo seleccionado en el formulario -->
<template id="tplFilePreview">
    <div class="file-preview">
        <div class="file-preview__thumb" data-ref="thumb">
            <img data-ref="thumbImg" alt="Vista previa" />
            <span data-ref="thumbIcon"></span>
        </div>
        <div class="file-preview__info">
            <div class="file-preview__name" data-ref="nombre"></div>
            <div class="file-preview__size" data-ref="tamano"></div>
        </div>
        <button class="file-preview__remove" data-ref="quitar" type="button" title="Quitar archivo" aria-label="Quitar archivo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
    </div>
</template>

<!-- Contenido del modal de detalle -->
<template id="tplDetalle">
    <div class="detail-content">
        <div class="detail-grid">
            <div class="detail-item"><small>Tipo</small><div><span class="tipo-badge" data-ref="tipo"></span></div></div>
            <div class="detail-item"><small>Categoría</small><div data-ref="categoria"></div></div>
            <div class="detail-item"><small>Materia</small><div data-ref="materia"></div></div>
            <div class="detail-item"><small>Publicado</small><div data-ref="subido"></div></div>
        </div>
        <div>
            <p class="detail-title">Comentario del docente</p>
            <div class="detail-texto" data-ref="comentario"></div>
        </div>
        <div>
            <p class="detail-title">Material</p>
            <div data-ref="vista"></div>
        </div>
    </div>
</template>

<!-- Material: mensaje cuando el archivo no está disponible -->
<template id="tplDetalleMuted">
    <div class="detail-muted"></div>
</template>

<!-- Material: imagen -->
<template id="tplDetalleImg">
    <img class="detail-img" alt="Material" />
</template>

<!-- Material: video de YouTube -->
<template id="tplDetalleVideo">
    <div class="detail-video">
        <iframe data-ref="frame" title="Video de YouTube" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
</template>

<!-- Material: archivo (PDF o Word) -->
<template id="tplDetalleArchivo">
    <div class="detail-file">
        <div>
            <div class="detail-file__name" data-ref="nombre"></div>
            <div class="detail-muted detail-muted--normal" data-ref="info"></div>
        </div>
        <button class="btn btn--outline" data-ref="abrir" type="button">Abrir PDF</button>
    </div>
</template>

<!-- Paginación (mismo diseño que los demás módulos) -->
<template id="tplPgBtn">
    <button class="pg-btn" type="button"></button>
</template>

<template id="tplPgDots">
    <span class="pg-dots">…</span>
</template>

@section Scripts {
    <script src="~/js/materiales.js" asp-append-version="true"></script>
}
